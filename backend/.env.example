NODE_ENV=development
PORT=4000
HOST=0.0.0.0
MONGODB_URI=mongodb://127.0.0.1:27017/fashion_commerce
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173
API_PUBLIC_URL=http://localhost:4000
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
TRUST_PROXY=0
ACCESS_TOKEN_SECRET=
COURIER_CREDENTIALS_ENCRYPTION_KEY=
MEDIA_STORAGE_PROVIDER=local
MEDIA_LOCAL_DIRECTORY=./uploads
MEDIA_PUBLIC_BASE_URL=
MEDIA_MAX_UPLOAD_BYTES=12000000
MEDIA_S3_BUCKET=
MEDIA_S3_REGION=us-east-1
MEDIA_S3_ENDPOINT=
MEDIA_S3_ACCESS_KEY_ID=
MEDIA_S3_SECRET_ACCESS_KEY=
MEDIA_S3_FORCE_PATH_STYLE=false
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
COOKIE_SECURE=false
# Set COOKIE_SECURE=true in production. Production startup refuses insecure refresh cookies.
COOKIE_SAME_SITE=lax
COOKIE_DOMAIN=
LOG_LEVEL=info
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=12
TENANT_HEADER=x-business-slug
BOOTSTRAP_BUSINESS_NAME=
BOOTSTRAP_BUSINESS_SLUG=
BOOTSTRAP_BUSINESS_DOMAIN=localhost
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
