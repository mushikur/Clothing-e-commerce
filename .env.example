## Copy these values to backend/.env for local API development.
NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/fashion_commerce
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
TRUST_PROXY=0
ACCESS_TOKEN_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
COOKIE_DOMAIN=
LOG_LEVEL=info
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=12
TENANT_HEADER=x-business-slug
BOOTSTRAP_BUSINESS_NAME=
BOOTSTRAP_BUSINESS_SLUG=
BOOTSTRAP_BUSINESS_DOMAIN=localhost
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
